{
    "name": "caner/state-machine",
    "description": "Transaction-safe state machines for Laravel Eloquent models",
    "keywords": [
        "caner",
        "state-machine",
        "laravel"
    ],
    "homepage": "https://github.com/CanerErgez/laravel-state-machine",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Caner Ergez",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Caner\\StateMachine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Caner\\StateMachine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Caner\\StateMachine\\StateMachineServiceProvider"
            ]
        }
    }
}
